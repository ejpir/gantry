 		}
 
 		buf += reclen;
@@ -330,6 +377,7 @@ static int parse_dirplusfile(char *buf, size_t nbytes, struct file *file,
 			fuse_force_forget(file, direntplus->entry_out.nodeid);
 	}
 
+	gantry_adapt_readdirplus(file, entries, directories);
 	return 0;
 }
 
