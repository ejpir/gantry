@@ -40,0 +43,9 @@ func main() {
+	if len(os.Args) == 2 && os.Args[1] == "session-anchor" {
+		// Gantry bind-mounts this trusted binary into its base workload
+		// container. The process owns no workload authority; it only keeps the
+		// assembled rootfs mounted while isolated session containers use it.
+		stop := make(chan os.Signal, 1)
+		signal.Notify(stop, syscall.SIGINT, syscall.SIGTERM)
+		<-stop
+		return
+	}
