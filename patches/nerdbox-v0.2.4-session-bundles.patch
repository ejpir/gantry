+func TestBundlePathRejectsUnsafeID(t *testing.T) {
+	service := &service{bundleRoot: t.TempDir()}
+	for _, id := range []string{"", "../escape", "a/b", `a\\b`} {
+		if _, err := service.bundlePath(id); err == nil {
+			t.Errorf("bundlePath(%q) succeeded", id)
+		}
+	}
+}
