+func TestDeleteRemovesBundle(t *testing.T) {
+	root := t.TempDir()
+	service := &service{bundleRoot: root}
+	if _, err := service.Create(context.Background(), &api.CreateRequest{
+		ID: "session-1", Files: map[string][]byte{"config.json": []byte("{}")},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := service.Scrub(context.Background(), &api.CreateRequest{ID: "session-1"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "session-1", "config.json")); !os.IsNotExist(err) {
+		t.Fatalf("config still exists after Scrub: %v", err)
+	}
+	if _, err := service.Delete(context.Background(), &api.CreateRequest{ID: "session-1"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "session-1")); !os.IsNotExist(err) {
+		t.Fatalf("bundle still exists after Delete: %v", err)
+	}
