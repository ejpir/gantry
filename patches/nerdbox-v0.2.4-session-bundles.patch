+	committed = true
@@ -82,0 +115,30 @@ func (s *service) Create(ctx context.Context, r *api.CreateRequest) (*api.Create
+
+// Scrub removes process and network configuration after task Create has
+// consumed them but before untrusted code starts. This keeps session secrets
+// out of the guest bundle for the running process lifetime.
+func (s *service) Scrub(_ context.Context, r *api.CreateRequest) (*emptypb.Empty, error) {
+	d, err := s.bundlePath(r.ID)
+	if err != nil {
+		return nil, errgrpc.ToGRPC(err)
+	}
+	for _, name := range []string{"config.json", "nw-config.json"} {
+		if err := os.Remove(filepath.Join(d, name)); err != nil && !os.IsNotExist(err) {
+			return nil, errgrpc.ToGRPC(err)
+		}
+	}
+	return &emptypb.Empty{}, nil
+}
+
+// Delete removes a bundle only after the host has deleted its task and
+// unmounted the bundle rootfs. Strict IDs keep cleanup beneath bundleRoot.
+func (s *service) Delete(ctx context.Context, r *api.CreateRequest) (*emptypb.Empty, error) {
+	d, err := s.bundlePath(r.ID)
+	if err != nil {
+		return nil, errgrpc.ToGRPC(err)
+	}
+	log.G(ctx).WithField("path", d).Info("deleting bundle")
+	if err := os.RemoveAll(d); err != nil {
+		return nil, errgrpc.ToGRPC(err)
+	}
+	return &emptypb.Empty{}, nil
+}
