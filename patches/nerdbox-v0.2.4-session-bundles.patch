+func (s *service) bundlePath(id string) (string, error) {
+	if id == "" || len(id) > 128 {
+		return "", fmt.Errorf("invalid bundle ID length")
+	}
+	for _, char := range id {
+		if (char < 'a' || char > 'z') && (char < 'A' || char > 'Z') &&
+			(char < '0' || char > '9') && char != '.' && char != '_' && char != '-' {
+			return "", fmt.Errorf("invalid character in bundle ID")
+		}
+	}
+	return filepath.Join(s.bundleRoot, id), nil
+}
