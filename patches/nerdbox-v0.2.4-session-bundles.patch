+func TestCreateRejectsUnsafeFileName(t *testing.T) {
+	root := t.TempDir()
+	service := &service{bundleRoot: root}
+	_, err := service.Create(context.Background(), &api.CreateRequest{
+		ID: "safe", Files: map[string][]byte{"../escape": []byte("bad")},
+	})
+	if err == nil {
+		t.Fatal("Create accepted an unsafe file name")
+	}
+	if _, err := os.Stat(filepath.Join(root, "safe")); !os.IsNotExist(err) {
+		t.Fatalf("rejected bundle was left behind: %v", err)
+	}
+}
