+/*
+ * Process an unsolicited notification supplied by an in-kernel transport.
+ * The ordinary /dev/fuse path accepts only userspace iterators; virtio-fs's
+ * Gantry notification queue owns a bounded kernel buffer instead.
+ */
+ssize_t fuse_dev_notify(struct fuse_dev *fud, void *buf, size_t len)
+{
+	struct fuse_copy_state cs;
+	struct kvec iov = { .iov_base = buf, .iov_len = len };
+	struct iov_iter iter;
+
+	if (!fud || !buf || len < sizeof(struct fuse_out_header))
+		return -EINVAL;
+
+	iov_iter_kvec(&iter, ITER_SOURCE, &iov, 1, len);
+	fuse_copy_init(&cs, false, &iter);
+	return fuse_dev_do_write(fud, &cs, len);
+}
+EXPORT_SYMBOL_GPL(fuse_dev_notify);
