+static int virtio_fs_queue_notification(struct virtio_fs_vq *fsvq,
+					struct virtio_fs_notification *notification)
+{
+	struct scatterlist sg;
+	bool kick;
+	int ret;
+
+	spin_lock(&fsvq->lock);
+	if (!fsvq->connected) {
+		spin_unlock(&fsvq->lock);
+		return -ENODEV;
+	}
+	sg_init_one(&sg, notification->buf, sizeof(notification->buf));
+	ret = virtqueue_add_inbuf(fsvq->vq, &sg, 1, notification, GFP_ATOMIC);
+	if (ret) {
+		spin_unlock(&fsvq->lock);
+		return ret;
+	}
+	kick = virtqueue_kick_prepare(fsvq->vq);
+	spin_unlock(&fsvq->lock);
+	if (kick)
+		virtqueue_notify(fsvq->vq);
+	return 0;
+}
+
+static void virtio_fs_notification_done_work(struct work_struct *work)
+{
+	struct virtio_fs_vq *fsvq = container_of(work, struct virtio_fs_vq,
+						 done_work);
+	struct virtio_fs_notification *notification;
+	unsigned int len;
+
+	for (;;) {
+		spin_lock(&fsvq->lock);
+		virtqueue_disable_cb(fsvq->vq);
+		notification = virtqueue_get_buf(fsvq->vq, &len);
+		if (!notification) {
+			if (!virtqueue_enable_cb(fsvq->vq)) {
+				spin_unlock(&fsvq->lock);
+				continue;
+			}
+			spin_unlock(&fsvq->lock);
+			break;
+		}
+		spin_unlock(&fsvq->lock);
+
+		mutex_lock(&fsvq->notification_lock);
+		if (len <= sizeof(notification->buf) && fsvq->notification_ready)
+			fuse_dev_notify(fsvq->fud, notification->buf, len);
+		mutex_unlock(&fsvq->notification_lock);
+		memset(notification->buf, 0, sizeof(notification->buf));
+		if (virtio_fs_queue_notification(fsvq, notification)) {
+			spin_lock(&fsvq->lock);
+			fsvq->notification_buffers--;
+			spin_unlock(&fsvq->lock);
+			kfree(notification);
+		}
+	}
+}
+
+static void virtio_fs_notification_dispatch_work(struct work_struct *work)
+{
+	(void)work;
+}
+
+static int virtio_fs_fill_notification_queue(struct virtio_fs_vq *fsvq)
+{
+	int ret = 0;
+
+	for (;;) {
+		struct virtio_fs_notification *notification;
+
+		spin_lock(&fsvq->lock);
+		if (fsvq->notification_buffers >= VIRTIO_FS_NOTIFICATION_BUFS) {
+			spin_unlock(&fsvq->lock);
+			break;
+		}
+		fsvq->notification_buffers++;
+		spin_unlock(&fsvq->lock);
+
+		notification = kzalloc_obj(*notification);
+		if (!notification) {
+			ret = -ENOMEM;
+			goto undo_count;
+		}
+		ret = virtio_fs_queue_notification(fsvq, notification);
+		if (ret) {
+			kfree(notification);
+undo_count:
+			spin_lock(&fsvq->lock);
+			fsvq->notification_buffers--;
+			spin_unlock(&fsvq->lock);
+			break;
+		}
+	}
+	return ret;
+}
