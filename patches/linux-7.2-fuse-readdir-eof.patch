+/*
+ * The marker is only meaningful on a connection that negotiated the
+ * extension. A guest may mount FUSE filesystems Gantry does not serve; for
+ * those a zero-length dirent must keep returning -EIO rather than silently
+ * truncating the directory.
+ */
+static bool fuse_gantry_is_readdir_eof(struct file *file,
+				       const struct fuse_dirent *dirent)
+{
+	struct fuse_conn *fc = get_fuse_conn(file_inode(file));
+
+	return fc->gantry_readdir_eof &&
+		!dirent->namelen &&
+		dirent->ino == FUSE_GANTRY_READDIR_EOF_INO &&
+		dirent->off == FUSE_GANTRY_READDIR_EOF_OFF &&
+		dirent->type == FUSE_GANTRY_READDIR_EOF_TYPE;
+}
+
+static void fuse_gantry_mark_readdir_eof(struct file *file, loff_t pos)
+{
+	struct fuse_file *ff = file->private_data;
+
+	ff->readdir.eof = true;
+	ff->readdir.eof_pos = pos;
+	if (ff->open_flags & FOPEN_CACHE_DIR)
+		fuse_readdir_cache_end(file, pos);
+}
