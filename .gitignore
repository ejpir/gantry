# build artifacts (regenerate: ./scripts/build.sh)
/artifacts/
/gantry
/seatbeltspike
/hostctl
/cmd/hostctl/hostctl
/minivm
/gantry-*
/hostctl-*
/minivm-*
*.exe

# guest assets (regenerate: ./scripts/build.sh, or copy from a nerdbox release)
/initramfs*.cpio.gz
/shell-rootfs.erofs
/nerdbox-kernel-*
/nerdbox-rootfs-*
/debug-kernel-*

# container images + rw layers (regenerate: ./scripts/mkimage.sh, ./scripts/mkrwlayer.sh)
/*.erofs
/rwlayer*.ext4

# gvproxy binaries (fetch from containers/gvisor-tap-vsock or build static)
/gvproxy-*

# runtime state
/.gantry/
*.sock
*.log

# guest build artifacts (built by scripts/mkrootfs-gvisor.sh)
/crunshim
pi-attach.tar
/pi-agent.tar

# local session exports (generated by pi tooling)
/pi-session-*.html
/integrations/pi-container/pi-export-*.html

# design/audit notes kept locally, not published
/docs/
