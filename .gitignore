# build artifacts (regenerate: go build ./ build.sh run-macos.sh)
/gantry
/hostctl
/cmd/hostctl/hostctl
/minivm
/gantry-*
/hostctl-*
/minivm-*
*.exe

# guest assets (regenerate: build.sh, or copy from Docker's sbx release)
/initramfs*.cpio.gz
/shell-rootfs.erofs
/nerdbox-kernel-*
/nerdbox-rootfs-*
/debug-kernel-*

# container images + rw layers (regenerate: mkimage.sh, mkrwlayer.sh)
/*.erofs
/rwlayer*.ext4

# gvproxy binaries (fetch from containers/gvisor-tap-vsock or build static)
/gvproxy-*

# runtime state
/.gantry/
*.sock
*.log

# guest build artifacts (built by mkrootfs-gvisor.sh)
/crunshim
